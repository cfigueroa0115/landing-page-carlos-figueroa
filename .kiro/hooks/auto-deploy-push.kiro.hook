{
  "enabled": true,
  "name": "Auto Deploy to Vercel",
  "description": "Automatically commits and pushes changes to GitHub when the agent stops, triggering a Vercel redeploy. This keeps production in sync with local changes in real-time.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "cd c:\\DesarrollosCF\\LandingPageCV_CF && git add -A && git diff --cached --quiet || (git commit -m \"auto: sync changes to production\" && git push origin master)"
  }
}